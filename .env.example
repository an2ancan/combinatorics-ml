# Environment Execution Mode
# False by default (Colab / cloud with drive mount), set to True for local runs
RUN_LOCALLY=True

# Local Data Directories
TSP_DATA_DIR="./TSP_Data"
TSP_RESULTS_DIR="./TSP_Data/baseline_results"

# Cloud Sync Configuration (rclone remote)
# Local configuration file (isolated to this repo, excluded from git)
RCLONE_CONFIG="./.rclone.conf"
RCLONE_REMOTE_DATA="gdrive:TSP_Data"
RCLONE_REMOTE_RESULTS="gdrive:TSP_Data/baseline_results"

# Optional: Google Cloud / Service Account Credentials
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service_account.json"
# GCP_STORAGE_BUCKET="gs://my-bucket/TSP_Data"

# Parallel Workers for Solvers
NUM_WORKERS=12
